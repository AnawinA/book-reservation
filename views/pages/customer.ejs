<%- include('../partials/header') %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">รายการหนังสือ</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">แดชบอร์ดของฉัน</span>
</nav>

<nav class="subnav" aria-label="ส่วนของแดชบอร์ด">
  <a href="#borrows">กำลังยืม</a>
  <a href="#donations">การบริจาค</a>
  <a href="#rewards">ของรางวัล</a>
</nav>

<section class="card profile-card">
  <div class="profile-identity">
    <span class="avatar" aria-hidden="true"><%= profile.username.charAt(0).toUpperCase() %></span>
    <div>
      <p class="eyebrow">สมาชิกผู้ใช้งาน</p>
      <h1 class="profile-name"><%= profile.username %></h1>
      <p class="muted"><%= profile.phone %></p>
    </div>
  </div>
  <div class="profile-stats">
    <div class="stat">
      <span class="stat-value"><%= profile.points %></span>
      <span class="stat-label">แต้มที่ใช้ได้ <span class="sr-only">points available</span></span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= borrows.length %></span>
      <span class="stat-label">กำลังยืม</span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= borrows.filter(function (b) { return b.isOverdue; }).length %></span>
      <span class="stat-label">เกินกำหนดส่ง</span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= donations.length %></span>
      <span class="stat-label">การบริจาค</span>
    </div>
  </div>
</section>

<section class="card" id="borrows">
  <div class="card-header">
    <h2>หนังสือที่กำลังยืม</h2>
    <span class="count-chip"><%= borrows.length %> เล่ม</span>
  </div>
  <% if (borrows.length === 0) { %>
    <p class="muted">คุณไม่มีหนังสือที่กำลังยืมอยู่ ไปที่ร้านค้าเพื่อยืมหนังสือได้เลย</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">ชื่อเรื่อง</th>
            <th scope="col">บาร์โค้ด</th>
            <th scope="col">ร้านค้า</th>
            <th scope="col">วันที่ยืม</th>
            <th scope="col">กำหนดส่งคืน</th>
            <th scope="col">สถานะ</th>
          </tr>
        </thead>
        <tbody>
          <% borrows.forEach(function (borrow) { %>
            <tr class="<%= borrow.isOverdue ? 'row-overdue' : '' %>">
              <td data-label="ชื่อเรื่อง"><strong><%= borrow.title %></strong></td>
              <td data-label="บาร์โค้ด"><%= borrow.barcode %></td>
              <td data-label="ร้านค้า"><%= borrow.shopName %></td>
              <td data-label="วันที่ยืม"><%= formatDate(borrow.borrowedAt) %></td>
              <td data-label="กำหนดส่งคืน"><%= formatDate(borrow.dueDate) %></td>
              <td data-label="สถานะ">
                <% if (borrow.isOverdue) { %>
                  <span class="badge badge-overdue">เกินกำหนดส่ง <%= Math.abs(borrow.daysRemaining) %> วัน</span>
                <% } else { %>
                  <span class="badge badge-available">เหลืออีก <%= borrow.daysRemaining %> วัน</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card" id="donations">
  <div class="card-header">
    <h2>ประวัติการบริจาคของฉัน</h2>
    <span class="count-chip"><%= donations.length %> รายการ</span>
  </div>
  <% if (donations.length === 0) { %>
    <p class="muted">คุณยังไม่ได้บริจาคหนังสือ การบริจาคแต่ละครั้งจะได้รับแต้มพื้นฐานและแต้มโบนัสจากแคมเปญที่เปิดอยู่</p>
  <% } else { %>
    <%
      var statusMap = {
        'AVAILABLE': 'พร้อมยืม',
        'BORROWED': 'กำลังยืม',
        'DAMAGED': 'ชำรุด',
        'LOST': 'สูญหาย'
      };
    %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">ชื่อเรื่อง</th>
            <th scope="col">บาร์โค้ด</th>
            <th scope="col">ร้านค้า</th>
            <th scope="col">แคมเปญ</th>
            <th scope="col">สถานะ</th>
          </tr>
        </thead>
        <tbody>
          <% donations.forEach(function (donation) { %>
            <tr>
              <td data-label="ชื่อเรื่อง"><strong><%= donation.title %></strong></td>
              <td data-label="บาร์โค้ด"><%= donation.barcode %></td>
              <td data-label="ร้านค้า"><%= donation.shopName %></td>
              <td data-label="แคมเปญ"><%= donation.campaignTitle || '-' %></td>
              <td data-label="สถานะ"><span class="badge badge-<%= donation.status.toLowerCase() %>"><%= statusMap[donation.status] || donation.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card" id="rewards">
  <div class="card-header">
    <h2>ของรางวัล</h2>
    <span class="count-chip">คุณมี <%= profile.points %> แต้ม</span>
  </div>
  <div class="reward-grid">
    <% rewards.forEach(function (reward) { %>
      <article class="reward-card">
        <span class="badge"><%= reward.shopName %></span>
        <h3><%= reward.title %></h3>
        <p class="muted">
          <span class="badge badge-bonus"><%= reward.pointsCost %> แต้ม</span>
          &middot; เหลือ <%= reward.stock %> ชิ้น
        </p>
        <button
          type="button"
          class="btn redeem-btn"
          data-reward-id="<%= reward.id %>"
          data-cost="<%= reward.pointsCost %>"
          data-title="<%= reward.title %>"
          <%= (reward.stock === 0 || reward.pointsCost > profile.points) ? 'disabled' : '' %>>
          <%= reward.stock === 0 ? 'สินค้าหมด' : (reward.pointsCost > profile.points ? 'แต้มไม่เพียงพอ' : 'แลกของรางวัล') %>
        </button>
      </article>
    <% }); %>
  </div>
  <div id="voucherBox" class="voucher-box" hidden>
    <h3>รหัสแลกรับของรางวัลของคุณ</h3>
    <pre id="voucherCode"></pre>
    <p class="hint">แสดงรหัสนี้ที่เคาน์เตอร์ของร้านค้า รหัสมีอายุ 72 ชั่วโมง (REWARD_CODE_TTL)</p>
  </div>
</section>

<%- include('../partials/footer') %>
