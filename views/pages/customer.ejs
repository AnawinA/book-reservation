<%- include('../partials/header') %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Catalog</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">My dashboard</span>
</nav>

<nav class="subnav" aria-label="Dashboard sections">
  <a href="#borrows">On loan</a>
  <a href="#donations">Donations</a>
  <a href="#rewards">Rewards</a>
</nav>

<section class="card profile-card">
  <div class="profile-identity">
    <span class="avatar" aria-hidden="true"><%= profile.username.charAt(0).toUpperCase() %></span>
    <div>
      <p class="eyebrow">Customer</p>
      <h1 class="profile-name"><%= profile.username %></h1>
      <p class="muted"><%= profile.phone %></p>
    </div>
  </div>
  <div class="profile-stats">
    <div class="stat">
      <span class="stat-value"><%= profile.points %></span>
      <span class="stat-label">points available</span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= borrows.length %></span>
      <span class="stat-label">On loan</span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= borrows.filter(function (b) { return b.isOverdue; }).length %></span>
      <span class="stat-label">Overdue</span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= donations.length %></span>
      <span class="stat-label">Donations</span>
    </div>
  </div>
</section>

<section class="card" id="borrows">
  <div class="card-header">
    <h2>Active borrows</h2>
    <span class="count-chip"><%= borrows.length %> item<%= borrows.length === 1 ? '' : 's' %></span>
  </div>
  <% if (borrows.length === 0) { %>
    <p class="muted">You have no books on loan. Visit a shop to borrow one.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Title</th>
            <th scope="col">Barcode</th>
            <th scope="col">Shop</th>
            <th scope="col">Borrowed</th>
            <th scope="col">Due</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% borrows.forEach(function (borrow) { %>
            <tr class="<%= borrow.isOverdue ? 'row-overdue' : '' %>">
              <td data-label="Title"><strong><%= borrow.title %></strong></td>
              <td data-label="Barcode"><%= borrow.barcode %></td>
              <td data-label="Shop"><%= borrow.shopName %></td>
              <td data-label="Borrowed"><%= formatDate(borrow.borrowedAt) %></td>
              <td data-label="Due"><%= formatDate(borrow.dueDate) %></td>
              <td data-label="Status">
                <% if (borrow.isOverdue) { %>
                  <span class="badge badge-overdue">Overdue by <%= Math.abs(borrow.daysRemaining) %> days</span>
                <% } else { %>
                  <span class="badge badge-available"><%= borrow.daysRemaining %> days left</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card" id="donations">
  <div class="card-header">
    <h2>My donations</h2>
    <span class="count-chip"><%= donations.length %> recorded</span>
  </div>
  <% if (donations.length === 0) { %>
    <p class="muted">You have not donated any books yet. Each donation earns base points plus any active campaign bonus.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Title</th>
            <th scope="col">Barcode</th>
            <th scope="col">Shop</th>
            <th scope="col">Campaign</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% donations.forEach(function (donation) { %>
            <tr>
              <td data-label="Title"><strong><%= donation.title %></strong></td>
              <td data-label="Barcode"><%= donation.barcode %></td>
              <td data-label="Shop"><%= donation.shopName %></td>
              <td data-label="Campaign"><%= donation.campaignTitle || '-' %></td>
              <td data-label="Status"><span class="badge badge-<%= donation.status.toLowerCase() %>"><%= donation.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card" id="rewards">
  <div class="card-header">
    <h2>Rewards</h2>
    <span class="count-chip">You have <%= profile.points %> pts</span>
  </div>
  <div class="reward-grid">
    <% rewards.forEach(function (reward) { %>
      <article class="reward-card">
        <span class="badge"><%= reward.shopName %></span>
        <h3><%= reward.title %></h3>
        <p class="muted">
          <span class="badge badge-bonus"><%= reward.pointsCost %> pts</span>
          &middot; <%= reward.stock %> in stock
        </p>
        <button
          type="button"
          class="btn redeem-btn"
          data-reward-id="<%= reward.id %>"
          data-cost="<%= reward.pointsCost %>"
          data-title="<%= reward.title %>"
          <%= (reward.stock === 0 || reward.pointsCost > profile.points) ? 'disabled' : '' %>>
          <%= reward.stock === 0 ? 'Out of stock' : (reward.pointsCost > profile.points ? 'Not enough points' : 'Redeem') %>
        </button>
      </article>
    <% }); %>
  </div>
  <div id="voucherBox" class="voucher-box" hidden>
    <h3>Your redemption code</h3>
    <pre id="voucherCode"></pre>
    <p class="hint">Show this code at the shop counter. It expires after 72 hours (REWARD_CODE_TTL).</p>
  </div>
</section>

<%- include('../partials/footer') %>
