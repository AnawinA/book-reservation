<%- include('../partials/header') %>

<% if (authRequired) { %>
  <div class="alert open-auth-btn" role="alert" style="cursor: pointer;" data-auth-mode="login">
    <span aria-hidden="true">&#9432;</span>
    <span>กรุณาเข้าสู่ระบบเพื่อเปิดแดชบอร์ดของคุณ (คลิกที่นี่เพื่อเข้าสู่ระบบ)</span>
  </div>
<% } %>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">เครือข่ายห้องสมุด สจล.</p>
    <h1>ยืมหนังสือ สะสมแต้ม แลกของรางวัล</h1>
    <p class="hero-lead">
      ค้นหารายการหนังสือในเครือข่าย ตรวจสอบสถานะความพร้อมแบบเรียลไทม์ และเปลี่ยนหนังสือที่คุณบริจาคเป็นแต้มสะสมสำหรับแลกกาแฟ กระเป๋าผ้า และอื่นๆ อีกมากมาย
    </p>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value"><%= pagination.total %></span>
        <span class="stat-label">รายชื่อหนังสือ</span>
      </div>
      <div class="stat">
        <span class="stat-value"><%= shops.length %></span>
        <span class="stat-label">ร้านค้า</span>
      </div>
      <div class="stat">
        <span class="stat-value"><%= campaigns.length %></span>
        <span class="stat-label">แคมเปญที่กำลังจัด</span>
      </div>
      <div class="stat">
        <span class="stat-value"><%= rewards.length %></span>
        <span class="stat-label">ของรางวัล</span>
      </div>
    </div>
  </div>

  <aside class="hero-aside" aria-label="ไฮไลต์">
    <% if (campaigns.length > 0) { %>
      <div class="spotlight">
        <p class="spotlight-label">แคมเปญที่กำลังจัดอยู่</p>
        <p class="spotlight-title"><%= campaigns[0].title %></p>
        <p class="spotlight-meta"><%= campaigns[0].shopName %></p>
        <span class="badge badge-bonus">+<%= campaigns[0].bonusPoints %> แต้ม ต่อการบริจาค</span>
      </div>
    <% } %>
    <% var featuredReward = rewards.find(function (r) { return r.stock > 0; }); %>
    <% if (featuredReward) { %>
      <div class="spotlight">
        <p class="spotlight-label">ของรางวัลแนะนำ</p>
        <p class="spotlight-title"><%= featuredReward.title %></p>
        <p class="spotlight-meta"><%= featuredReward.shopName %> &middot; <%= featuredReward.pointsCost %> แต้ม</p>
      </div>
    <% } %>
    <% if (!currentUser) { %>
      <a class="btn open-auth-btn" href="#loginForm" data-auth-mode="login">เข้าสู่ระบบเพื่อยืมหนังสือ</a>
    <% } %>
  </aside>
</section>

<section class="card" aria-labelledby="how-heading">
  <div class="card-header">
    <h2 id="how-heading">ขั้นตอนการใช้งาน</h2>
    <span class="count-chip">สำหรับผู้ใช้งานและร้านค้า</span>
  </div>
  <div class="step-grid">
    <article class="step">
      <span class="step-number" aria-hidden="true">1</span>
      <h3>บริจาคหนังสือ</h3>
      <p>ร้านค้าจะสแกน ISBN และเบอร์โทรศัพท์ของคุณ คุณจะได้รับแต้มพื้นฐานพร้อมแต้มโบนัสจากแคมเปญที่เปิดอยู่</p>
    </article>
    <article class="step">
      <span class="step-number" aria-hidden="true">2</span>
      <h3>ยืมหนังสือที่คุณชอบ</h3>
      <p>ยืมหนังสือกลับบ้านได้ตามระยะเวลาที่กำหนด แดชบอร์ดของคุณจะคอยติดตามวันกำหนดส่งและแจ้งเตือนเมื่อเกินกำหนด</p>
    </article>
    <article class="step">
      <span class="step-number" aria-hidden="true">3</span>
      <h3>แลกของรางวัล</h3>
      <p>ใช้แต้มสะสมแลกของรางวัลจากร้านค้า และแสดงรหัสแลกรับที่เคาน์เตอร์เพื่อรับของรางวัล</p>
    </article>
  </div>
</section>

<section class="card" aria-labelledby="catalog-heading">
  <div class="card-header">
    <h2 id="catalog-heading">รายการหนังสือ <span class="sr-only">Book Catalog</span></h2>
    <span class="count-chip"><%= pagination.total %> รายการ</span>
  </div>

  <form method="get" action="/" class="toolbar" role="search">
    <div class="field">
      <label for="q">ค้นหา</label>
      <input type="search" id="q" name="q" value="<%= query.q %>" placeholder="ชื่อเรื่อง, ผู้แต่ง หรือ ISBN" maxlength="100">
    </div>
    <div class="field">
      <label for="category">หมวดหมู่</label>
      <select id="category" name="category">
        <option value="">ทุกหมวดหมู่</option>
        <% categories.forEach(function (item) { %>
          <option value="<%= item %>" <%= query.category === item ? 'selected' : '' %>><%= item %></option>
        <% }); %>
      </select>
    </div>
    <button class="btn" type="submit">กรองรายการ</button>
  </form>

  <% if (books.length === 0) { %>
    <p class="muted">ไม่พบหนังสือที่ตรงกับเงื่อนไขนี้ ลองค้นหาด้วยคำสำคัญหรือหมวดหมู่อื่น</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">ชื่อเรื่อง</th>
            <th scope="col">ผู้แต่ง</th>
            <th scope="col">หมวดหมู่</th>
            <th scope="col">ISBN</th>
            <th scope="col">สถานะความพร้อม</th>
          </tr>
        </thead>
        <tbody>
          <% books.forEach(function (book) { %>
            <tr>
              <td data-label="ชื่อเรื่อง"><strong><%= book.title %></strong></td>
              <td data-label="ผู้แต่ง"><%= book.author %></td>
              <td data-label="หมวดหมู่"><span class="badge"><%= book.category %></span></td>
              <td data-label="ISBN"><%= book.isbn %></td>
              <td data-label="สถานะความพร้อม">
                <span class="badge <%= book.availableCopies > 0 ? 'badge-available' : 'badge-borrowed' %>">
                  ว่าง <%= book.availableCopies %> จาก <%= book.totalCopies %> เล่ม
                </span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <nav class="pagination" aria-label="หน้ารายการหนังสือ">
      <% if (pagination.page > 1) { %>
        <a href="/?q=<%= encodeURIComponent(query.q) %>&amp;category=<%= encodeURIComponent(query.category) %>&amp;page=<%= pagination.page - 1 %>">&larr; ก่อนหน้า</a>
      <% } else { %>
        <span></span>
      <% } %>
      <span>หน้า <%= pagination.page %> จาก <%= pagination.totalPages %></span>
      <% if (pagination.page < pagination.totalPages) { %>
        <a href="/?q=<%= encodeURIComponent(query.q) %>&amp;category=<%= encodeURIComponent(query.category) %>&amp;page=<%= pagination.page + 1 %>">ถัดไป &rarr;</a>
      <% } else { %>
        <span></span>
      <% } %>
    </nav>
  <% } %>
</section>

<section class="grid-2">
  <div class="card">
    <div class="card-header">
      <h2>แคมเปญที่กำลังจัด</h2>
      <span class="count-chip"><%= campaigns.length %> แคมเปญ</span>
    </div>
    <% if (campaigns.length === 0) { %>
      <p class="muted">ขณะนี้ไม่มีแคมเปญที่กำลังจัดอยู่ การบริจาคยังคงได้รับแต้มพื้นฐานตามปกติ</p>
    <% } else { %>
      <ul class="plain-list">
        <% campaigns.forEach(function (campaign) { %>
          <li class="list-item">
            <span class="list-item-main">
              <span class="list-item-title"><%= campaign.title %></span>
              <span class="list-item-meta"><%= campaign.shopName %></span>
            </span>
            <span class="badge badge-bonus">+<%= campaign.bonusPoints %> แต้ม</span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>ของรางวัล</h2>
      <span class="count-chip"><%= rewards.length %> รายการ</span>
    </div>
    <% if (rewards.length === 0) { %>
      <p class="muted">ยังไม่มีของรางวัลเผยแพร่ในขณะนี้</p>
    <% } else { %>
      <ul class="plain-list">
        <% rewards.forEach(function (reward) { %>
          <li class="list-item">
            <span class="list-item-main">
              <span class="list-item-title"><%= reward.title %></span>
              <span class="list-item-meta"><%= reward.shopName %> &middot; เหลือ <%= reward.stock %> ชิ้น</span>
            </span>
            <span class="badge"><%= reward.pointsCost %> แต้ม</span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</section>

<section class="card" aria-labelledby="shops-heading">
  <div class="card-header">
    <h2 id="shops-heading">ร้านค้าในเครือข่าย</h2>
    <span class="count-chip"><%= shops.length %> ร้าน</span>
  </div>
  <% if (shops.length === 0) { %>
    <p class="muted">ยังไม่มีร้านค้าที่เปิดให้บริการในขณะนี้</p>
  <% } else { %>
    <div class="shop-grid">
      <% shops.forEach(function (shop) { %>
        <article class="shop-card">
          <h3><%= shop.name %></h3>
          <p class="shop-meta"><%= shop.location %></p>
          <div class="shop-stats">
            <span class="badge <%= shop.availableItems > 0 ? 'badge-available' : 'badge-borrowed' %>"><%= shop.availableItems %> เล่มพร้อมยืม</span>
            <span class="badge badge-borrowed"><%= shop.borrowedItems %> เล่มกำลังถูกยืม</span>
            <span class="badge"><%= shop.totalItems %> เล่มทั้งหมด</span>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

<% if (!currentUser) { %>
  <!-- Auth Modal Panel (Login / Register) with blurred background -->
  <div class="modal-backdrop" id="authModal" role="dialog" aria-modal="true" aria-labelledby="authLoginPanel" hidden>
    <div class="modal-dialog auth-modal-dialog">
      <div class="modal-header">
        <div class="auth-tabs" role="tablist" aria-label="ตัวเลือกการเข้าใช้งาน">
          <button type="button" class="auth-tab-btn is-active" id="tabLoginBtn" role="tab" aria-selected="true" aria-controls="authLoginPanel">
            เข้าสู่ระบบ
          </button>
          <button type="button" class="auth-tab-btn" id="tabRegisterBtn" role="tab" aria-selected="false" aria-controls="authRegisterPanel">
            สมัครสมาชิก
          </button>
        </div>
        <button type="button" class="modal-close-btn" id="authModalClose" aria-label="ปิด">&times;</button>
      </div>

      <!-- Panel 1: เข้าสู่ระบบ (Login) -->
      <div class="auth-panel is-active" id="authLoginPanel" role="tabpanel" aria-labelledby="tabLoginBtn">
        <h2 id="loginForm" class="auth-heading">ยินดีต้อนรับเข้าสู่ระบบ</h2>
        <p class="muted auth-subheading">กรอกชื่อผู้ใช้และรหัสผ่านเพื่อเข้าใช้งาน</p>
        <form id="loginFormEl" class="stack">
          <div class="field">
            <label for="login-username">ชื่อผู้ใช้</label>
            <input id="login-username" name="username" autocomplete="username" required>
          </div>
          <div class="field">
            <label for="login-password">รหัสผ่าน</label>
            <input id="login-password" name="password" type="password" autocomplete="current-password" required>
          </div>
          <button class="btn btn-full" type="submit">เข้าสู่ระบบ</button>
          <p class="hint">บัญชีทดสอบใช้รหัสผ่านจาก <code>SEED_DEFAULT_PASSWORD</code></p>
        </form>
        <div class="auth-switch-prompt">
          <span>ยังไม่มีบัญชีผู้ใช้?</span>
          <button type="button" class="link-btn switch-to-register">สมัครสมาชิกที่นี่</button>
        </div>
      </div>

      <!-- Panel 2: สมัครสมาชิก (Register / Signin) -->
      <div class="auth-panel" id="authRegisterPanel" role="tabpanel" aria-labelledby="tabRegisterBtn" hidden>
        <h2 class="auth-heading">สมัครสมาชิกสำหรับผู้ใช้งาน</h2>
        <p class="muted auth-subheading">สร้างบัญชีใหม่เพื่อเริ่มยืมหนังสือและสะสมแต้ม</p>
        <form id="registerForm" class="stack">
          <div class="field">
            <label for="register-username">ชื่อผู้ใช้</label>
            <input id="register-username" name="username" autocomplete="username" required minlength="3" maxlength="30" placeholder="3-30 ตัวอักษร, ตัวเลข หรือ _">
          </div>
          <div class="field">
            <label for="register-phone">เบอร์โทรศัพท์มือถือ (ไทย)</label>
            <input id="register-phone" name="phone" inputmode="numeric" pattern="0[0-9]{9}" required placeholder="08xxxxxxxx">
          </div>
          <div class="field">
            <label for="register-password">รหัสผ่าน</label>
            <input id="register-password" name="password" type="password" autocomplete="new-password" required minlength="8" placeholder="อย่างน้อย 8 ตัวอักษร ประกอบด้วยตัวอักษรและตัวเลข">
          </div>
          <button class="btn btn-full" type="submit">สร้างบัญชี</button>
          <p class="hint">บัญชีใหม่เริ่มต้นด้วย 0 แต้ม และสามารถยืมหนังสือได้ตามจำนวนที่ระบบกำหนด</p>
        </form>
        <div class="auth-switch-prompt">
          <span>มีบัญชีผู้ใช้อยู่แล้ว?</span>
          <button type="button" class="link-btn switch-to-login">เข้าสู่ระบบที่นี่</button>
        </div>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
