  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="brand-mark" aria-hidden="true">B</span>
        <div>
          <strong>ระบบยืมคืนหนังสือ</strong>
          <p>บริจาคหนังสือ สะสมแต้ม แลกของรางวัลได้ทั่วเครือข่ายร้านค้า</p>
        </div>
      </div>
      <nav class="footer-links" aria-label="ลิงก์ส่วนท้าย">
        <a href="/">รายการหนังสือ</a>
        <% if (currentUser && currentUser.role === 'Customer') { %>
          <a href="/customer/dashboard">หนังสือของฉัน</a>
        <% } else if (currentUser && currentUser.role === 'OwnerShop') { %>
          <a href="/shop/dashboard">เคาน์เตอร์ร้านค้า</a>
        <% } else if (currentUser && currentUser.role === 'Admin') { %>
          <a href="/admin/dashboard">การจัดการระบบ</a>
        <% } else { %>
          <a href="/#loginForm" class="open-auth-btn" data-auth-mode="login">เข้าสู่ระบบ</a>
        <% } %>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> ระบบยืมคืนหนังสือ &middot; KMITL Server-Side Web Development</p>
    </div>
  </footer>
  <script src="/js/api.js"></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
