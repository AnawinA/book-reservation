<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title><%= title %> | Book Borrowing</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  <% var path = typeof currentPath === 'string' ? currentPath : ''; %>
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="site-nav" aria-label="Main navigation">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">B</span>
      <span class="brand-text">Book Borrowing</span>
    </a>
    <div class="nav-links">
      <a class="nav-link" href="/" aria-current="<%= path === '/' ? 'page' : 'false' %>">Catalog</a>

      <% if (currentUser && currentUser.role === 'Customer') { %>
        <a class="nav-link" href="/customer/dashboard" aria-current="<%= path === '/customer/dashboard' ? 'page' : 'false' %>">My books</a>
      <% } else if (currentUser && currentUser.role === 'OwnerShop') { %>
        <a class="nav-link" href="/shop/dashboard" aria-current="<%= path === '/shop/dashboard' ? 'page' : 'false' %>">Shop counter</a>
      <% } else if (currentUser && currentUser.role === 'Admin') { %>
        <a class="nav-link" href="/admin/dashboard" aria-current="<%= path === '/admin/dashboard' ? 'page' : 'false' %>">Administration</a>
      <% } %>

      <% if (currentUser) { %>
        <span class="user-chip">
          <span class="user-dot" aria-hidden="true"></span>
          <%= currentUser.username || currentUser.role %>
        </span>
      <% } %>

      <button type="button" id="themeToggle" class="theme-toggle" aria-pressed="false" aria-label="Switch to dark mode" title="Switch to dark mode">
        <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
      </button>

      <% if (currentUser) { %>
        <button type="button" id="logoutBtn" class="btn btn-ghost btn-sm">Log out</button>
      <% } else { %>
        <a class="btn btn-sm" href="/#loginForm">Log in</a>
      <% } %>
    </div>
  </nav>
  <div id="flash" role="status" aria-live="polite"></div>
  <main class="container" id="main">
