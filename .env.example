# Runtime
NODE_ENV=development
PORT=3000

# Database
DB_HOST=db
DB_PORT=3306
DB_USER=bbs_user
DB_PASSWORD=bbs_password
DB_NAME=book_borrowing
DB_CONNECTION_LIMIT=10
MYSQL_ROOT_PASSWORD=root_password

# Auth secrets (64 chars in production)
JWT_SECRET=change_me_to_a_64_char_random_string
JWT_EXPIRES_IN=1d
REWARD_CODE_SECRET=change_me_too_to_a_64_char_random_string
REWARD_CODE_TTL=72h
BCRYPT_ROUNDS=10
COOKIE_SECURE=false

# Business rules
DONATION_BASE_POINTS=10
DEFAULT_BORROW_DAYS=14
MAX_BORROW_DAYS=30
MAX_ACTIVE_BORROWS=5

# Seeding
SEED_ON_START=true
SEED_DEFAULT_PASSWORD=Passw0rd!
